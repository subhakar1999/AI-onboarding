# MeterMind Enterprise Engine - Production Environment Configuration
# Copy this file to '.env' and fill in the values before deploying to production

# Environment & Security
PROJECT_NAME="MeterMind Enterprise Engine"
ENV="production"
DEBUG=False
SECRET_KEY="GENERATE_A_SECURE_RANDOM_STRING_HERE"
CORS_ORIGINS='["https://your-production-domain.com", "http://localhost:8000"]'

# Database
# If running via docker-compose, use 'db' as the host. If external, use your RDS/CloudSQL URL.
DATABASE_URL="postgresql+asyncpg://agentforge_admin:SecurePass123!@db:5432/agentforge_db"

# LLM Inference
OPENAI_API_KEY="sk-your-openai-api-key-here"

# SMTP Email Configuration (For Magic Links)
# Example using Gmail App Passwords, SendGrid, Amazon SES, or Mailgun
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@yourdomain.com"

